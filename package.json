{
  "name": "bizdays-toolkit",
  "version": "0.6.0",
  "description": "Holidays, business-day calendar and day-by-day schedules (e.g. store hours) with time zone support. Japanese holidays verified against the Cabinet Office data. / 祝日と営業日のカレンダー（タイムゾーン対応・日本の祝日は内閣府データで全日照合）",
  "keywords": [
    "bizdays",
    "business-day",
    "business-days",
    "calendar",
    "holiday",
    "holidays",
    "japan",
    "workday",
    "営業日",
    "祝日"
  ],
  "homepage": "https://github.com/inohan77/bizdays-toolkit#readme",
  "bugs": {
    "url": "https://github.com/inohan77/bizdays-toolkit/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inohan77/bizdays-toolkit.git"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jp": {
      "types": "./dist/jp/index.d.ts",
      "default": "./dist/jp/index.js"
    },
    "./diagnose": {
      "types": "./dist/diagnose/index.d.ts",
      "default": "./dist/diagnose/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src scripts test",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:tz": "node scripts/test-tz.ts",
    "bench": "node scripts/bench.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:tz && pnpm build && pnpm fmt:check && node scripts/check-package.ts && node scripts/check-size.ts && node scripts/api-report.ts",
    "verify:cao": "node scripts/verify-cao.ts",
    "prepublishOnly": "pnpm check",
    "release-notes": "node scripts/release-notes.ts",
    "api:update": "pnpm build && node scripts/api-report.ts --update"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
